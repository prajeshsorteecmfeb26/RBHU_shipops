# ---------------------------------------------------------------
# ShipOps API - environment variables (see docs/environment-variables.md)
# Copy to .env for local development. NEVER commit real secrets.
# In Azure these are App Service settings / Key Vault references.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL (docker-compose default)
DATABASE_URL=postgresql://shipops:shipops@localhost:5432/shipops?schema=public

# Comma-separated browser origins allowed by CORS and the WebSocket origin check
CORS_ORIGINS=http://localhost:5173

# --- Auth: local (mock login + HS256 JWT) | entra (Microsoft Entra ID tokens)
AUTH_MODE=local
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=8h
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_API_AUDIENCE=api://shipops-api

# --- AI assistant: mock | openai | azure
AI_PROVIDER=mock
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
AI_TIMEOUT_MS=30000
AI_MAX_HISTORY_MESSAGES=20

# --- Analytics microservice (Flask)
ANALYTICS_SERVICE_URL=http://localhost:5001
ANALYTICS_API_KEY=dev-internal-key-change-me

# --- Announcements (Bonus 3): mock | sharepoint
ANNOUNCEMENTS_SOURCE=mock
# SHAREPOINT_SITE_ID=contoso.sharepoint.com,<site-guid>,<web-guid>
# SHAREPOINT_LIST_ID=<list-guid>
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=

WS_HEARTBEAT_MS=30000
RATE_LIMIT_PER_MINUTE=300
SWAGGER_ENABLED=true

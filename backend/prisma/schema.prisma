// ShipOps data model
// Conventions:
//  - UUID primary keys (safe to expose, no enumeration attacks)
//  - Audit fields on every business table: createdAt/updatedAt/createdBy/updatedBy
//  - Soft delete via deletedAt/deletedBy (customers), filtered in the repository layer
//  - snake_case table/column names in Postgres, camelCase in TypeScript

// Rust-free Prisma Client: the query compiler runs as WebAssembly and talks to
// Postgres through node-postgres (@prisma/adapter-pg). No native engine binary to
// ship, which keeps App Service deployments small and platform-independent.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "queryCompiler"]
  engineType      = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

enum CustomerStatus {
  Active
  Inactive
}

enum ShipmentStatus {
  Created
  PickedUp
  InTransit
  OutForDelivery
  Delivered
  Exception
  Cancelled
}

enum ChatRole {
  system
  user
  assistant
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         Role     @default(OPERATOR)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  conversations Conversation[]

  @@map("users")
}

model Customer {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  // Uniqueness among *non-deleted* customers is enforced by a partial unique index
  // (see migration 0001_init: customers_email_active_key) so a soft-deleted
  // customer's email can be reused.
  email     String
  company   String
  status    CustomerStatus @default(Active)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  createdBy String?        @map("created_by")
  updatedBy String?        @map("updated_by")
  deletedAt DateTime?      @map("deleted_at")
  deletedBy String?        @map("deleted_by")

  shipments Shipment[]

  @@index([deletedAt])
  @@index([status])
  @@index([email])
  @@map("customers")
}

model Shipment {
  id             String         @id @default(uuid()) @db.Uuid
  trackingNumber String         @unique @map("tracking_number")
  customerId     String         @map("customer_id") @db.Uuid
  origin         String
  destination    String
  status         ShipmentStatus @default(Created)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  createdBy      String?        @map("created_by")
  updatedBy      String?        @map("updated_by")

  customer      Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  statusHistory ShipmentStatusHistory[]

  @@index([customerId])
  @@index([status])
  @@map("shipments")
}

/// Append-only audit trail of every shipment status transition.
model ShipmentStatusHistory {
  id         String          @id @default(uuid()) @db.Uuid
  shipmentId String          @map("shipment_id") @db.Uuid
  fromStatus ShipmentStatus? @map("from_status")
  toStatus   ShipmentStatus  @map("to_status")
  note       String?
  changedBy  String?         @map("changed_by")
  changedAt  DateTime        @default(now()) @map("changed_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, changedAt])
  @@map("shipment_status_history")
}

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String   @default("New conversation")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@map("conversations")
}

model ChatMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           ChatRole
  content        String
  promptTokens   Int?     @map("prompt_tokens")
  outputTokens   Int?     @map("output_tokens")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

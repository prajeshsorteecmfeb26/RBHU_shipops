# Shared secret; must equal ANALYTICS_API_KEY in backend/.env (Key Vault secret in Azure)
INTERNAL_API_KEY=dev-internal-key-change-me
MAX_UPLOAD_MB=5
MAX_ROWS=200000
TOP_N_SALESPEOPLE=10
ENABLE_PNG_EXPORT=true
# Only if a browser calls this service directly (normally it goes through the Node API)
CORS_ORIGINS=
LOG_LEVEL=INFO
PORT=5001
